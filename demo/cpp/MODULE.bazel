module(
    name = "nvim-dap-image-demo",
    version = "0.1.0",
)

# apple_support registers Apple toolchains that produce relative N_OSO debug
# info paths. Without it, Bazel's sandbox creates absolute paths to deleted
# sandbox dirs, breaking breakpoint resolution in LLDB/GDB debuggers.
# Must come before rules_cc for toolchain registration order.
bazel_dep(name = "apple_support", version = "2.5.3")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "opencv", version = "4.13.0.bcr.5")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "7fe1eab26d2b8eeb5e1c6a2f38bddb001e3f9696",
)
